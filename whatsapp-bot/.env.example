# Same Postgres database the main backend uses - the bot only adds one extra
# table (bot_whatsapp_session) to store its WhatsApp login, nothing else.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# The main site's backend API
SITE_API_URL=https://dailytrade-backend.onrender.com

# Must match SCHEDULER_API_KEY in the backend's own .env / Render env vars
SCHEDULER_API_KEY=change-me-to-match-the-backend

# The WhatsApp group/channel JID to post task announcements to.
# Leave blank for the very first run - connect once, then run `npm run list-groups`
# to see the JID of every group the linked account is in, and fill this in.
WHATSAPP_TARGET_JID=

# Optional - port for the tiny health-check server (needed if hosting on Render,
# which requires binding to $PORT to treat this as a web service)
PORT=3000

# Your OWN personal WhatsApp number (not the group/channel above) - Live Chat
# messages from users get relayed here, and you reply from WhatsApp like normal.
# Format: <country code><number, no +, no spaces/dashes>@s.whatsapp.net
# Example for a Ghana number +233 55 123 4567: 233551234567@s.whatsapp.net
# Leave blank to disable the Live Chat bridge (everything else still works).
# Set this only on Render's dashboard, never through the website's admin panel -
# it controls where private user messages get forwarded.
WHATSAPP_ADMIN_JID=
